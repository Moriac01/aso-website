# Copiez ce fichier en `.env` (dans le dossier frontend/) et remplissez les valeurs.
# Le fichier .env n'est JAMAIS commité.

# Base PostgreSQL (Neon) — chaîne de connexion « Pooled connection » de votre branche Neon.
# Utilisez une branche Neon « dev » pour le développement, et une base séparée pour la production.
DATABASE_URL=postgresql://utilisateur:motdepasse@ep-xxxx-pooler.region.aws.neon.tech/aso?sslmode=require

# Clé secrète du back-office (chiffrement des sessions). Générez-la avec :
#   openssl rand -hex 32
# Valeur différente en développement et en production. Ne la partagez jamais.
PAYLOAD_SECRET=

# URL publique du site (sans / final). Sert aussi aux liens dans les emails.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Envoi des emails — compte Gmail de l'association (facultatif en local).
# Laissés vides : aucun email n'est envoyé, ils s'affichent seulement dans la console.
# SMTP_PASS n'est PAS le mot de passe Gmail : c'est un « mot de passe d'application »
# (Compte Google → Sécurité → Validation en deux étapes → Mots de passe des applications).
SMTP_USER=
SMTP_PASS=
# Valeurs par défaut adaptées à Gmail ; à changer seulement pour un autre service.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# EMAIL_FROM=          # adresse d'expédition, si différente de SMTP_USER
# EMAIL_FROM_NAME=ASO — Soutien aux Orphelins
